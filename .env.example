# Скопируйте в .env и заполните: cp .env.example .env
DJANGO_SETTINGS_MODULE=config.settings.dev

# Обязательно смените в проде. Сгенерировать:
# python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=dev-insecure-change-me
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000

# Пусто = SQLite в /app/data/db.sqlite3
# Postgres: postgres://user:pass@db:5432/lawyer
DATABASE_URL=

# Кому уходят заявки. Бэкенды через запятую: telegram, email, console
NOTIFICATION_BACKENDS=console
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=site@example.com
LEAD_NOTIFY_EMAIL=

# Публичный адрес сайта — нужен для ссылок в уведомлениях
SITE_URL=http://localhost:8000

# Антиспам: сколько заявок с одного IP за окно (в минутах)
LEAD_RATE_LIMIT=5
LEAD_RATE_WINDOW_MINUTES=10
