# Caddy сам получает и продлевает сертификат Let's Encrypt.
# Домен задаётся переменной DOMAIN в .env
{$DOMAIN} {
	encode gzip zstd

	handle_path /static/* {
		root * /srv/static
		file_server
		header Cache-Control "public, max-age=31536000, immutable"
	}

	handle_path /media/* {
		root * /srv/media
		file_server
	}

	handle {
		reverse_proxy web:8000
	}
}
